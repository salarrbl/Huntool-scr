[
  {
    "name": "dnsx",
    "command": "dnsx",
    "args": [
      "-l",
      "{{target}}",
      "-json",
      "-silent",
      "-a",
      "-cname",
      "-threads",
      "250",
      "-retry",
      "3"
    ],
    "timeout_seconds": 1800,
    "priority": 2,
    "enabled": true,
    "retries": 2
  },
  {
    "name": "httpx",
    "command": "httpx",
    "args": [
      "-list",
      "{{target}}",
      "-json",
      "-silent",
      "-title",
      "-sc",
      "-duc",
      "-cdn",
      "-cl",
      "-tech-detect",
      "-threads",
      "150"
    ],
    "timeout_seconds": 1800,
    "priority": 3,
    "enabled": true,
    "retries": 3
  },
  {
    "name": "Csprecon",
    "command": "csprecon",
    "args": ["-l", "{{target}}", "-s", "-c", "100", "-silent"],
    "timeout_seconds": 1800,
    "priority": 5,
    "enabled": true,
    "retries": 2
  },
  {
    "name": "Nuclei",
    "command": "nuclei",
    "args": [
      "-t",
      "/root/WatchDogs/cve/",
      "-l",
      "{{target}}",
      "-duc",
      "-silent"
    ],
    "timeout_seconds": 3600,
    "priority": 6,
    "enabled": false,
    "retries": 1
  }
]

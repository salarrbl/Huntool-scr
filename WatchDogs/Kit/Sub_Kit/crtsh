#!/usr/bin/env python3

import argparse
import json
import time

import requests


class CertTracker(object):
    def __init__(self):
        self.session = requests.Session()
        self.session.headers.update(
            {
                "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0"
            }
        )

    def query_certs(self, target_domain, use_wildcard=True, include_ex=True):
        base_endpoint = "https://crt.sh/?q={}&output=json"

        params = []
        if not include_ex:
            params.append("exclude=expired")
        if use_wildcard and "%" not in target_domain:
            target_domain = "%.{}".format(target_domain)

        final_url = base_endpoint.format(target_domain)
        if params:
            final_url += "&" + "&".join(params)

        # Try with increasing timeouts
        timeouts = [20, 30, 45]

        for attempt, timeout_val in enumerate(timeouts, 1):
            try:
                response = self.session.get(final_url, timeout=timeout_val)
                response.raise_for_status()

                raw_content = response.text
                if not raw_content.strip():
                    return []

                try:
                    parsed_data = json.loads(raw_content)
                    return parsed_data
                except json.JSONDecodeError:
                    # Handle concatenated JSON objects
                    if "}{[" in raw_content or "}{" in raw_content:
                        fixed_json = "[{}]".format(raw_content.replace("}{", "},{"))
                        parsed_data = json.loads(fixed_json)
                        return parsed_data
                    else:
                        print(f"[ERROR] Invalid JSON response: {raw_content[:100]}...")
                        return []

            except requests.exceptions.ReadTimeout:
                if attempt < len(timeouts):
                    time.sleep(2)  # Brief pause before retry
                continue
            except requests.exceptions.RequestException as e:
                if attempt < len(timeouts):
                    time.sleep(1)
                    continue
                print(f"[ERROR] Network issue: {e}")
                return []
            except json.JSONDecodeError as e:
                print(f"[ERROR] JSON parsing failed: {e}")
                return []
            except Exception as e:
                if attempt < len(timeouts):
                    time.sleep(1)
                    continue
                print(f"[ERROR] Unexpected error: {e}")
                return []

        print("[ERROR] All attempts failed due to timeouts or network issues")
        return []

    def clean_output(self, cert_data, common_names_only=False):
        if common_names_only:
            unique_names = set()
            for entry in cert_data:  # Fixed the typo here
                if isinstance(entry, dict) and "common_name" in entry:
                    unique_names.add(entry["common_name"])
            return sorted(list(unique_names))
        return cert_data


def main():
    parser = argparse.ArgumentParser(description="Certificate transparency lookup tool")
    parser.add_argument("target", help="Domain to search for")
    parser.add_argument(
        "--no-wildcard",
        "-nw",
        action="store_true",
        help="Do not prepend wildcard to domain",
    )
    parser.add_argument(
        "--include-ex", "-ie", action="store_true", help="Include expired certificates"
    )
    parser.add_argument(
        "--common-names", "-cn", action="store_true", help="Show only common names"
    )
    parser.add_argument("--output", "-o", help="Save output to JSON file")

    args = parser.parse_args()

    tracker = CertTracker()
    results = tracker.query_certs(
        args.target, use_wildcard=not args.no_wildcard, include_ex=not args.include_ex
    )

    if results:
        cleaned_results = tracker.clean_output(
            results, common_names_only=args.common_names
        )

        if args.common_names:
            # Print clean, newline-separated output instead of JSON array
            for name in cleaned_results:
                print(name)
        else:
            if args.output:
                with open(args.output, "w") as output_file:
                    json.dump(cleaned_results, output_file, indent=4)
                print(f"Results saved to: {args.output}")
            else:
                # Show clean common names by default (when no output file specified)
                unique_common_names = set()
                for entry in results:
                    if isinstance(entry, dict) and "common_name" in entry:
                        unique_common_names.add(entry["common_name"])

                for name in sorted(unique_common_names):
                    print(name)
    else:
        print("[INFO] No certificates found or error occurred")


if __name__ == "__main__":
    main()
